server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse proxy to the backend so the browser can call same-origin /api,
    # matching this repo's VITE_API_URL=/api convenience mode. 127.0.0.1
    # works because docker-compose.yml runs every service with
    # network_mode: host in this single-CT setup (see its top-of-file note).
    # For frontend and backend on separate hosts/CTs, see
    # docker-compose.backend.yml, where this needs to be a real hostname.
    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Re-set (not append) the X-authentik-* identity headers from
        # whatever Traefik's forward-auth already put on this request, then
        # stamp our own internal secret. This lets backend tell "came
        # through this nginx hop" apart from "sent directly by some other
        # container on the edge network" (e.g. node-red, which POSTs
        # straight to backend:3000 for ingestion, bypassing Traefik/Authentik
        # by design — see server/middleware/authentikIdentity.js).
        # ${INTERNAL_PROXY_SECRET} is filled in from the environment at
        # container start (this file is an nginx envsubst template — see
        # client/Dockerfile).
        proxy_set_header X-authentik-username $http_x_authentik_username;
        proxy_set_header X-authentik-email $http_x_authentik_email;
        proxy_set_header X-authentik-groups $http_x_authentik_groups;
        proxy_set_header X-Internal-Proxy-Secret "${INTERNAL_PROXY_SECRET}";
    }

    # React Router / client-side routing fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
