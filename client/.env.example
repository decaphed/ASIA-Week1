# ── Frontend configuration ──────────────────────────────────────────────
# Copy to ".env":  cp .env.example .env
# Vite only exposes variables that start with VITE_ to the browser.

# Base URL of the backend API. The api.js service prepends this to every
# request (e.g. `${VITE_API_URL}/live`).
#
#   • Full URL (default below) → the browser calls the backend directly;
#     this works because the backend enables CORS for the dev origin.
#   • Relative "/api"          → uses the Vite dev proxy in vite.config.js
#     (same-origin, no CORS). Use this if you prefer.
VITE_API_URL=http://localhost:3000/api
