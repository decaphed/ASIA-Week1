# ── Single-CT stack configuration ───────────────────────────────────────
# Used by the root docker-compose.yml (see
# docs/plan/2026-08-10-single-ct-consolidation.md). Copy this file to ".env"
# on this CT and set every value below, then bring the stack up in the
# staged order documented in that plan's §7 — do not run
# `docker compose up -d` for everything at once.

# ── Core ─────────────────────────────────────────────────────────────────

# The origin the browser serves the dashboard from. Used by CORS (see
# server/app.js) to allow the browser to call the API, and matched against
# the Origin header on same-origin POSTs (same-origin GETs don't send one).
# On this topology the browser always reaches the stack through Traefik at
# http://dashboard.home, so that's the value to keep here — not the internal
# Docker DNS name "client", which the browser never resolves.
CLIENT_ORIGIN=http://dashboard.home

# 1-in-N sampling cadence for banking a periodic NEGATIVE_SAMPLE fault_events
# row during normal (non-fault) operation. Default: ~1/hour at the 60-second
# window cadence.
PDM_NEGATIVE_SAMPLE_RATE=60

# ── Postgres ─────────────────────────────────────────────────────────────
# Consumed directly by the `postgres` service in docker-compose.yml. The
# `:?` guards there fail startup loudly if any of these are unset.

# Superuser password for the postgres role inside the timescaledb image.
POSTGRES_SUPERUSER_PASSWORD=change-me

# Password for the pdm_app application role (owns pump_telemetry). Also
# used to build `backend`'s DATABASE_URL directly in docker-compose.yml —
# there is no separate DATABASE_URL variable, so this is the only place
# this password is set (see the plan's "Why DATABASE_URL is now built from
# PDM_APP_PASSWORD" section).
PDM_APP_PASSWORD=change-me

# Password for the authentik_svc application role (owns authentik_db). See
# db/init/02-create-authentik-db.sh.
AUTHENTIK_PG_PASSWORD=change-me

# ── Authentik / Traefik ──────────────────────────────────────────────────

# Documentation-only. Traefik's file provider
# (authentik/traefik/dynamic/dynamic.yml) does NOT read these — it
# hardcodes the hostnames as literals, and neither does the blueprint
# (authentik/blueprints/dashboard-proxy-provider.yaml). If you change a
# hostname, you must edit BOTH of those files by hand; these two vars exist
# only as a single documented record of what the stack was configured for.
AUTH_DASHBOARD_HOST=dashboard.home
AUTH_AUTHENTIK_HOST=auth.home
AUTH_NODERED_HOST=nodered.home

# Pin an explicit release — NEVER "latest". Authentik migrations are
# tag-coupled; an unplanned image pull mid-upgrade can wedge the database.
# invalidation_flow is unconditionally required on the blueprint's proxy
# provider at this pinned version (see the blueprint file's comments).
AUTHENTIK_TAG=2026.5.6

# Generate with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=change-me

# Bootstrap vars are read ONLY on first boot against an empty authentik_db.
# Changing them later has no effect — they don't reset the akadmin
# password on an already-initialized database. With these set, the
# http://auth.home/if/flow/initial-setup/ flow is intentionally
# unreachable; log in at http://auth.home/ instead.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@dashboard.home
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
