# ── Split-host deployment configuration ─────────────────────────────────
# Used by docker-compose.backend.yml for CORS (see server/app.js).
# Copy this file to ".env" on the backend host and set CLIENT_ORIGIN,
# then run: docker compose -f docker-compose.backend.yml up -d

# Must exactly match what the browser sends as the Origin header when
# calling the API — i.e. the frontend's externally-accessible address:
#   - LAN/CT IP:                       http://192.168.1.50:5173
#   - port-forwarded to a workstation: http://localhost:5173
# NOT the internal hostname "frontend" — the browser never resolves that.
CLIENT_ORIGIN=http://localhost:5173
