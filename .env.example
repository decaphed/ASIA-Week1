# ── Split-host deployment configuration ─────────────────────────────────
# Used by docker-compose.backend.yml for CORS (see server/app.js).
# Copy this file to ".env" on the backend host and set CLIENT_ORIGIN,
# then run: docker compose -f docker-compose.backend.yml up -d

# Must exactly match what the browser sends as the Origin header when
# calling the API — i.e. the frontend's externally-accessible address:
#   - LAN/CT IP:                       http://192.168.1.50:5173
#   - port-forwarded to a workstation: http://localhost:5173
# NOT the internal hostname "frontend" — the browser never resolves that.
CLIENT_ORIGIN=http://localhost:5173

# Used by docker-compose.backend.yml. Base URL of the pdm-python CT/container
# running the PdM Tier 1 service (docker-compose.pdm.yml) — the actual
# split-CT deployment target for PdM (see §1's note on why it's its own
# compose file). The "pdm" hostname is resolved via docker-compose.backend
# .yml's extra_hosts entry (mirroring the frontend->backend extra_hosts
# pattern), which maps it to the pdm-python CT's actual LAN IP — update that
# entry if the CT's IP ever changes, rather than hardcoding an IP here.
PDM_SERVICE_URL=http://pdm:8000
