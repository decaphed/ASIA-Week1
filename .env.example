# ── Split-host deployment configuration ─────────────────────────────────
# Used by docker-compose.backend.yml for CORS (see server/app.js) and DB
# connectivity (see server/database/db.js).
# Copy this file to ".env" on the backend host and set these, then run:
#   docker compose -f docker-compose.backend.yml up -d

# Connection string for the PostgreSQL 16 + TimescaleDB instance running on
# its own Proxmox CT (see docs/plan/2026-08-04-timescaledb-migration.md §0).
DATABASE_URL=postgres://pdm_app:PASSWORD@10.10.10.15:5432/pump_telemetry

# Must exactly match what the browser sends as the Origin header when
# calling the API — i.e. the frontend's externally-accessible address:
#   - LAN/CT IP:                       http://192.168.1.50:5173
#   - port-forwarded to a workstation: http://localhost:5173
#   - behind the Authentik/Traefik gate (docs/plan/2026-08-09-authentik-
#     split-ct.md): http://dashboard.home — same-origin POSTs carry an
#     Origin header even though same-origin GETs don't, so keep this
#     truthful once the auth CT is live.
# NOT the internal hostname "frontend" — the browser never resolves that.
CLIENT_ORIGIN=http://localhost:5173

# Used by docker-compose.backend.yml. Base URL of the pdm-python CT/container
# running the PdM Tier 1 service (docker-compose.pdm.yml) — the actual
# split-CT deployment target for PdM (see §1's note on why it's its own
# compose file). The "pdm" hostname is resolved via docker-compose.backend
# .yml's extra_hosts entry (mirroring the frontend->backend extra_hosts
# pattern), which maps it to the pdm-python CT's actual LAN IP — update that
# entry if the CT's IP ever changes, rather than hardcoding an IP here.
PDM_SERVICE_URL=http://pdm:8000

# ── pdm-db CT's own vars ─────────────────────────────────────────────────
# Consumed directly by docker-compose.db.yml on the pdm-db CT (10.10.10.15)
# — previously used but undocumented here; the :? guards in
# docker-compose.db.yml now fail startup loudly if these are unset.
# Superuser password for the postgres role inside the timescaledb image.
POSTGRES_SUPERUSER_PASSWORD=change-me
# Password for the pdm_app application role (owns pump_telemetry).
PDM_APP_PASSWORD=change-me
# Password for the authentik_svc application role (owns authentik_db) —
# see docs/plan/2026-08-09-authentik-split-ct.md §5.1.
AUTHENTIK_PG_PASSWORD=change-me
