{
  "name": "live-data-dashboard-server",
  "version": "1.0.0",
  "description": "Express + SQLite backend that ingests, stores and serves live IoT sensor readings from Node-RED.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "quality-report": "node scripts/qualityReport.js"
  },
  "keywords": [
    "iot",
    "express",
    "sqlite",
    "node-red",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
