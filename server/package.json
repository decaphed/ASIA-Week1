{
  "name": "live-data-dashboard-server",
  "version": "1.0.0",
  "description": "Express + SQLite backend that ingests, stores and serves live IoT sensor readings from Node-RED.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "quality-report": "node scripts/qualityReport.js",
    "migrate": "node-pg-migrate -m database/migrations",
    "migrate:up": "node-pg-migrate up -m database/migrations",
    "migrate:down": "node-pg-migrate down -m database/migrations",
    "test": "node --test $(find scripts/tests -maxdepth 1 -name '*.test.mjs' ! -name '*pdm*' ! -name '*faultEvent*')"
  },
  "keywords": [
    "iot",
    "express",
    "postgresql",
    "timescaledb",
    "node-red",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-yaml": "^4.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.1.9"
  }
}
