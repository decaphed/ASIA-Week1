# ── Backend configuration ───────────────────────────────────────────────
# Copy this file to ".env" and adjust if needed:  cp .env.example .env
# The backend reads these at startup via dotenv (see server.js).

# Port the Express server listens on. Node-RED and the React client both
# expect the API at http://localhost:3000, so keep this as 3000 unless you
# also update node-red/flow.json and client/.env.
PORT=3000

# Where the SQLite database file lives (relative to the server/ folder).
# The file is created automatically on first run if it does not exist.
DB_PATH=./data.db

# The origin the browser serves the frontend from. Used by CORS to allow
# the browser to call this API. For local dev this is Vite's default port
# (http://localhost:5173); when frontend/backend run on separate hosts,
# set this to the frontend's externally-accessible address (see root
# .env.example / docker-compose.backend.yml for the split-host case).
CLIENT_ORIGIN=http://localhost:5173

# ── Predictive Maintenance (PdM) ────────────────────────────────────────
# Base URL of the Python pdm/ FastAPI service (see docker-compose.pdm.yml).
# pdmService.js POSTs each closed window here for a Tier 1 rule-engine
# verdict. Pointing this at a different container/CT is a config change.
PDM_SERVICE_URL=http://localhost:8000

# 1-in-N sampling cadence for banking a periodic NEGATIVE_SAMPLE fault_events
# row during normal (non-fault) operation — see §3.3.1. Default: ~1/hour at
# the 60-second window cadence.
PDM_NEGATIVE_SAMPLE_RATE=60
