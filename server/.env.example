# ── Backend configuration ───────────────────────────────────────────────
# Copy this file to ".env" and adjust if needed:  cp .env.example .env
# The backend reads these at startup via dotenv (see server.js).

# Port the Express server listens on. Node-RED and the React client both
# expect the API at http://localhost:3000, so keep this as 3000 unless you
# also update node-red/flow.json and client/.env.
PORT=3000

# Where the SQLite database file lives (relative to the server/ folder).
# The file is created automatically on first run if it does not exist.
DB_PATH=./data.db

# The origin the React dev server runs on. Used by CORS to allow the
# browser to call this API. Vite's default dev port is 5173.
CLIENT_ORIGIN=http://localhost:5173
