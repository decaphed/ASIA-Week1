# ── PdM Python service configuration ────────────────────────────────────
# Thresholds live in app/thresholds.yaml, and the port is fixed at 8000
# (see Dockerfile / docker-compose.pdm.yml).

# §15.1/D51 — where model.py reads model.joblib/metadata.json from, and
# where training.py writes them. Set by docker-compose.yml for the
# containerized service (/app/artifacts, pdm_artifacts volume); defaults to
# pdm/app/artifacts locally when unset (see training.py::_artifact_dir()).
# PDM_ARTIFACT_DIR=

# §14.2.2/D20 — config-gated model family override. Unset (or
# "random_forest") uses training_config.yaml's default; "xgboost" switches
# training.py::fit_model()'s estimator, requiring xgboost to be installed.
# PDM_MODEL_FAMILY=

# §10.5/§10.6 item 2: read-only Postgres role for pdm/app/corpus.py's
# batch/offline access to training_corpus. Deliberately a SEPARATE,
# narrower-scoped var from server/'s DATABASE_URL — this connection must
# only ever be granted SELECT on training_corpus (never fault_events,
# raw_telemetry, or write access to anything). Python never writes
# application data (§3.4's invariant, unchanged) — training-run results go
# through server/scripts/recordTrainingRun.js instead.
PDM_CORPUS_DB_URL=postgresql://pdm_corpus_readonly:change-me@postgres:5432/pump_telemetry
