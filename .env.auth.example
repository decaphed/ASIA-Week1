# ── Auth CT (Traefik + Authentik) configuration ─────────────────────────
# Used by docker-compose.auth.yml. Copy this file to ".env" on the auth CT
# and set these, then run:
#   docker compose -f docker-compose.auth.yml up -d
#
# Bring up authentik-redis + authentik-server + authentik-worker FIRST and
# confirm migrations complete against pdm-db before adding traefik to the
# picture — see docs/plan/2026-08-09-authentik-split-ct.md §7.2.

# Documentation-only. Traefik's file provider (authentik/traefik/dynamic/
# dynamic.yml) does NOT read these — it hardcodes the hostnames as
# literals, and neither does the blueprint (authentik/blueprints/
# dashboard-proxy-provider.yaml). If you change a hostname, you must edit
# BOTH of those files by hand; these two vars exist only as a single
# documented record of what the stack was configured for.
AUTH_DASHBOARD_HOST=dashboard.home
AUTH_AUTHENTIK_HOST=auth.home

# Connection details for Authentik's database on the shared pdm-db CT
# (10.10.10.15). Database/role are provisioned by db/init/02-create-
# authentik-db.sh on a fresh volume, or by hand on the live instance — see
# docs/runbook/authentik-operations.md.
AUTHENTIK_PG_HOST=10.10.10.15
AUTHENTIK_PG_PORT=5432
AUTHENTIK_PG_USER=authentik_svc
AUTHENTIK_PG_PASSWORD=change-me
AUTHENTIK_PG_DB=authentik_db

# Pin an explicit release — NEVER "latest". Authentik migrations are
# tag-coupled; an unplanned image pull mid-upgrade can wedge the database.
# invalidation_flow is unconditionally required on the blueprint's proxy
# provider at this pinned version (see the blueprint file's comments).
AUTHENTIK_TAG=2026.5.6

# Generate with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=change-me

# Bootstrap vars are read ONLY on first boot against an empty authentik_db.
# Changing them later has no effect — they don't reset the akadmin
# password on an already-initialized database. With these set, the
# http://auth.home/if/flow/initial-setup/ flow is intentionally
# unreachable; log in at http://auth.home/ instead.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@dashboard.home
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me
